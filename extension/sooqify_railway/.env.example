# Copy variable names only into Railway's private variable store. Never commit actual values.
AUDIT_API_TOKEN=replace-with-a-long-random-secret-at-least-32-characters
ALPHACODE_SYNC_URL=https://your-existing-sync-host.example/sync.php
ALPHACODE_SYNC_TOKEN=set-only-in-Railway-variables
DATA_DIR=/data
APP_TIMEZONE=Asia/Aden
ENABLE_SCHEDULER=true
LOG_LEVEL=INFO

# Optional linked-device worker. Keep false until the WhatsApp number is selected.
WHATSAPP_ENABLED=false
WHATSAPP_PRIMARY_NUMBER=15551234567
AUDIT_SERVICE_URL=https://your-service.up.railway.app
