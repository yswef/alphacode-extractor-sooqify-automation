# =============================================================
# AlphaCode Extractor — .gitignore
# =============================================================
# القاعدة: كل ما هو بيانات محلية، مفاتيح، ملفات بيئة، مخرجات
# مؤقتة، أو أدوات تطوير لا يجب أن يصل لـgit.
# Rule: local data, secrets, env files, temporary outputs,
# and dev tooling stay out of git.
# =============================================================


# ─────────────────────────────────────────
# Python — bytecode & caches
# ─────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
ENV/
zimp/
.pytest_cache/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/


# ─────────────────────────────────────────
# بيانات المنتجات المحلية (لا ترفعها أبداً)
# Local product data — never commit
# ─────────────────────────────────────────
backend/archive_db.json
backend/archive_db.backup_*.json
backend/sync_queue.json
backend/sync_state.json
backend/data/sync_queue.json
backend/data/sync_state.json
backend/id_counter.json

# Arabic: قفل الإيقاف الطارئ وحالة إعادة الرفع ومجلد النسخ الاحتياطية — كلها حالة جهاز محلي
#         (القفل يحمل بصمة رمز الحماية المحلي، والنسخ تحمل بيانات المنتجات). لا تُرفع أبداً.
# English: The emergency-shutdown lock, the re-upload state and the backup folder - all local
#          machine state (the lock holds the local guard hash, the backups hold product data).
backend/config/sync_lock.json
backend/data/restore_state.json
backend/data/neutralize_state.json
backend/backups/

# ملف تكوين المسارات يحتوي على مسارات الجهاز المحلي
# paths_config contains local machine paths
backend/paths_config.json
backend/config/paths_config.json

# ملفات التكوين الحساسة (فيها URLs وتوكنات)
# Sensitive config files (contain URLs & tokens)
backend/sync_config.json
backend/config/sync_config.json


# ─────────────────────────────────────────
# سجلات اللوق — Log files
# ─────────────────────────────────────────
backend/logs/
backend/images/
backend/downloads/
backend/tmp/
backend/.env
Build_history.sh
.env
*.log
*.jsonl


# ─────────────────────────────────────────
# تقارير Excel وPDF المولّدة
# Generated Excel / PDF reports
# ─────────────────────────────────────────
backend/reports/
*.xlsx
*.pdf


# ─────────────────────────────────────────
# كاش الذكاء الاصطناعي
# AI response cache
# ─────────────────────────────────────────
backend/ai_cache.json
backend/ai_cache.backup_*.json


# ─────────────────────────────────────────
# أرشيف الصور المحلية (مجلد حفظ المنتجات)
# Local product image archive
# ─────────────────────────────────────────
# أضف مسار مجلد الحفظ الخاص بك هنا لو كان داخل المشروع
# Add your save-folder path here if it's inside the project
# e.g.: Products/


# ─────────────────────────────────────────
# أدوات التطوير والمحررات
# IDEs & editors
# ─────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
.continue/
.cursor/
*.code-workspace


# ─────────────────────────────────────────
# ملفات البيئة (مفاتيح API)
# Environment files (API keys)
# ─────────────────────────────────────────
.env
.env.*
!.env.example


# ─────────────────────────────────────────
# نظام التشغيل
# OS artifacts
# ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ─────────────────────────────────────────
# ملفات اختبار مؤقتة
# Temporary test files
# ─────────────────────────────────────────
backend/test_*.py
!backend/test_upload_main_image_only.py


# ─────────────────────────────────────────
# Node.js (لو استُخدم)
# Node.js (if ever used)
# ─────────────────────────────────────────
node_modules/
package-lock.json


# ─────────────────────────────────────────
# ملفات ضغط مؤقتة
# Temporary archives
# ─────────────────────────────────────────
*.zip
*.tar.gz
*.rar

# Arabic: بيانات اعتماد لوحة التقارير - لا تُرفع أبداً (كانت متتبَّعة بنص صريح).
# English: Reports panel credentials - never commit (was previously tracked in plaintext).
backend/config/reports_config.json
reports_config.json


# ─────────────────────────────────────────
# ملفات الاستضافة التي لا تدخل Git أبداً (سكربت المزامنة نفسه مُتتبَّع لتوثيق العقد)
# Host files that never enter Git (the sync script itself is tracked to document the contract)
# ─────────────────────────────────────────
hostinger/alphacode_storage/db.php
hostinger/alphacode_storage/db_config.php
hostinger/alphacode_storage/sync_write_helpers.php
hostinger/alphacode_storage/check_db_health.php
hostinger/alphacode_storage/test_connection.php
# Arabic: ملف القفل الذي يكتبه action=erase على الاستضافة (حالة تشغيل لا كود).
# English: The lock file action=erase writes on the host (runtime state, not code).
hostinger/alphacode_storage/shutdown.lock
